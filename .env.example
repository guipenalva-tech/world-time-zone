NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Google AdSense (bottom banner). Leave both empty to render the dev
# placeholder instead of loading the real ad script/unit. See README > Ads
# setup for how to get these once the AdSense account is approved.
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT_BOTTOM=

# Default in-feed AdSense unit, shown after every section of the home
# dashboard (Map, Chart, Weather, Sun, Currency, Flights, News). AdSense
# allows repeating the same ad unit multiple times per page, so a single
# slot id covers all of them — no new env var needed as sections are added.
# Optional — leave empty to render the same dev placeholder as the bottom
# banner in every one of those spots.
NEXT_PUBLIC_ADSENSE_SLOT_INFEED_1=

# Legacy fallback only: pre-consolidation deployments that set only the
# unit below (and never _INFEED_1) keep working. New setups should just use
# NEXT_PUBLIC_ADSENSE_SLOT_INFEED_1 above and can leave this empty.
NEXT_PUBLIC_ADSENSE_SLOT_INFEED_2=

# OpenWeatherMap (optional, currently unused — Weather page runs on the
# free/keyless Open-Meteo API instead). Kept for a future upgrade path
# (severe weather alerts, air quality) if we ever need it.
NEXT_PUBLIC_OPENWEATHER_KEY=
